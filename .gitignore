# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*

# Signing material and App Store Connect keys
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
ExportOptions.plist

# Build products
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local release builds, screenshots and logs
/build
*.log

# Not source code, kept on disk only: App Store listing, privacy policy and support texts,
# and the App Store screenshot tooling (its output goes to /build/screenshots)
/store/
/tools/screenshots.sh
/tools/compose-screenshots.py
/tools/nursery-scene.py

# Generated by @bacons/apple-targets from assets/icon.png on every prebuild
/targets/*/Assets.xcassets/AppIcon.appiconset/

# Python tools (tools/*.py)
.venv/
venv/
__pycache__/
*.pyc

# Editors
.vscode/
.idea/

# Not published: agent notes, docs, specs and store texts stay on disk only
AGENTS.md
